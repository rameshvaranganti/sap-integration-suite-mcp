SAP_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_AUTH_MODE=oauth2
SAP_REQUEST_TIMEOUT_MS=30000
MCP_PORT=3000
MCP_HOST=127.0.0.1
# Required when binding outside loopback; use an independent, high-entropy secret.
MCP_HTTP_TOKEN=
# Comma-separated exact Host authorities and Origin URLs for remote deployments.
MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
MCP_ALLOWED_ORIGINS=
LOG_LEVEL=info
